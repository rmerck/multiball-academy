# Every record of SDL configure results in cmake/preseed must be what
# cmake/IosPreseed.cmake accepts: the four header keys, and otherwise only
# lines NAME=1 or NAME= whose name is a yes-or-no probe result. The loader
# refuses anything else when an iOS build is configured; this says so on
# every system, when the file is changed.
# Usage: cmake -DSOURCE_DIR=<repository> -P CheckPreseed.cmake
cmake_minimum_required(VERSION 3.26)
if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "SOURCE_DIR is required")
endif()
include("${SOURCE_DIR}/cmake/IosPreseedKeys.cmake")
file(GLOB entries "${SOURCE_DIR}/cmake/preseed/*")
foreach(entry IN LISTS entries)
  get_filename_component(name "${entry}" NAME)
  if(IS_DIRECTORY "${entry}" OR IS_SYMLINK "${entry}"
     OR NOT name MATCHES "^sdl-ios-([0-9A-Za-z]+)-(iphoneos|iphonesimulator)[.]txt$")
    message(FATAL_ERROR "cmake/preseed/${name} is not a record (sdl-ios-<Xcode build>-<SDK>.txt)")
  endif()
  set(xcode "${CMAKE_MATCH_1}")
  set(sdk "${CMAKE_MATCH_2}")
  file(STRINGS "${entry}" lines)
  set(keys "")
  set(results 0)
  foreach(line IN LISTS lines)
    if(line MATCHES "^# (xcode|sdk|deployment-target|pinned-deps-sha256): ([0-9A-Za-z.]+)$")
      list(APPEND keys "${CMAKE_MATCH_1}")
      if((CMAKE_MATCH_1 STREQUAL "xcode" AND NOT CMAKE_MATCH_2 STREQUAL xcode)
         OR (CMAKE_MATCH_1 STREQUAL "sdk" AND NOT CMAKE_MATCH_2 STREQUAL sdk))
        message(FATAL_ERROR "cmake/preseed/${name}: the header disagrees with the file's name: ${line}")
      endif()
    elseif(line MATCHES "^#" OR line STREQUAL "")
    elseif(line MATCHES "^([A-Za-z0-9_]+)=(1?)$")
      set(result "${CMAKE_MATCH_1}")
      if(NOT result MATCHES "${PINBALL_PRESEED_NAME}")
        message(FATAL_ERROR "cmake/preseed/${name}: '${result}' is not a probe result")
      endif()
      math(EXPR results "${results} + 1")
    else()
      message(FATAL_ERROR "cmake/preseed/${name}: not a result line: ${line}")
    endif()
  endforeach()
  list(SORT keys)
  if(NOT keys STREQUAL "deployment-target;pinned-deps-sha256;sdk;xcode")
    message(FATAL_ERROR "cmake/preseed/${name}: the header must hold each of the four keys once")
  endif()
  if(results LESS 50)
    message(FATAL_ERROR "cmake/preseed/${name}: only ${results} results")
  endif()
  message(STATUS "cmake/preseed/${name}: ${results} results")
endforeach()
