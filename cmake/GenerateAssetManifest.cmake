# Writes a C++ fragment listing every PNG under ASSETS_DIR with its size and
# SHA-256. Included by src/platform/EmbeddedManifest.cpp.
# Usage: cmake -DASSETS_DIR=<dir> -DOUTPUT=<file> -P GenerateAssetManifest.cmake
cmake_minimum_required(VERSION 3.26)
if(NOT DEFINED ASSETS_DIR OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "ASSETS_DIR and OUTPUT are required")
endif()

file(GLOB_RECURSE files RELATIVE "${ASSETS_DIR}" "${ASSETS_DIR}/*.png")
list(SORT files)

set(content "// Generated by cmake/GenerateAssetManifest.cmake. Do not edit.\n")
foreach(name IN LISTS files)
  # Apply the same rules as the runtime check (core/AssetName.cpp and the
  # loader's size limit), so a bad asset fails the build, not the first run.
  string(LENGTH "${name}" name_length)
  if(NOT name MATCHES "^[a-z0-9_-][a-z0-9_.-]*(/[a-z0-9_-][a-z0-9_.-]*)*[.]png$"
     OR name MATCHES "[.]/" OR name MATCHES "[.][.]" OR name_length GREATER 128)
    message(FATAL_ERROR "Asset name is not allowed: ${name}")
  endif()
  if(name MATCHES "(^|/)(con|prn|aux|nul|com[0-9]|lpt[0-9])([.]|$)")
    message(FATAL_ERROR "Asset name uses a reserved device name: ${name}")
  endif()
  file(SIZE "${ASSETS_DIR}/${name}" size)
  if(size EQUAL 0 OR size GREATER 16777216)
    message(FATAL_ERROR "Asset is empty or larger than 16 MB: ${name}")
  endif()
  file(SHA256 "${ASSETS_DIR}/${name}" digest)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " bytes "${digest}")
  string(APPEND content "{\"${name}\", ${size}ULL, {{${bytes}}}},\n")
endforeach()

# Only touch the file when it changes, so unchanged assets do not force a rebuild.
set(previous "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
endif()
if(NOT content STREQUAL previous)
  file(WRITE "${OUTPUT}" "${content}")
endif()
