#pragma once

// Generated by CMake from cmake/VersionConfig.hpp.in. Every value comes
// from the name and identifier block at the top of CMakeLists.txt, and the
// version from project() there; the bundle's Info.plist is filled in from
// the same values.

namespace pinball {

// The game's name as the player sees it: window title, panel, About screen.
inline constexpr const char* kGameTitle = "@PINBALL_APP_NAME@";
inline constexpr const char* kGameVersion = "@PROJECT_VERSION@";
// Rises with every build that is handed out; shown beside the version.
inline constexpr const char* kBuildNumber = "@PINBALL_BUILD_NUMBER@";
inline constexpr const char* kGameIdentifier = "@PINBALL_BUNDLE_ID@";
// The per-user directory the high scores are kept in, under the system's
// place for application data, and the directory above it (empty for none).
inline constexpr const char* kDataOrganisation = "@PINBALL_DATA_ORG@";
inline constexpr const char* kDataDirectory = "@PINBALL_DATA_DIR@";
// Where the privacy policy is published.
inline constexpr const char* kPrivacyUrl = "@PINBALL_PRIVACY_URL@";
// Where players write for support (the About page, docs/SUPPORT.md).
inline constexpr const char* kSupportEmail = "@PINBALL_SUPPORT_EMAIL@";

}  // namespace pinball
